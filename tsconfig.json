{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "shared/**/*.mts",
    "src/**/*.mjs",
    "src/**/*.mts",
    "web/*.mjs",
    "web/*.mts",
    "web/*.js",
    "fixtures/doubles/*.mjs",
    "test/**/*.test.mts"
  ],
  "exclude": [
    "web/generated"
  ]
}
