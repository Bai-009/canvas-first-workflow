{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "shared",
    "outDir": "web/generated",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["shared/**/*.mts"]
}
